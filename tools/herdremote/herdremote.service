# User service for HerdRemote. Install:
#   cp herdremote.service ~/.config/systemd/user/
#   systemctl --user edit herdremote     (set ExecStart to your checkout)
#   systemctl --user enable --now herdremote
#   journalctl --user -u herdremote -f
[Unit]
Description=HerdRemote: herdr agents on the iPod's System > Agents
After=default.target

[Service]
ExecStart=/usr/bin/python3 %h/podbox/tools/herdremote/herdremote.py
# Without this the journal gets the log in blocks, minutes late
Environment=PYTHONUNBUFFERED=1
# Inherit DBUS_SESSION_BUS_ADDRESS from the graphical session's user manager.
# Optional voice config (CLI options override these):
# Environment=HERDREMOTE_VOICE_FOCUS=on
# Environment=HERDREMOTE_VOICE_MAX_HOLD=120
# Environment=HERDREMOTE_VOICE_METHOD=HoldStart
# The list order's times: ~/.local/state/herdremote/order.json
StateDirectory=herdremote
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
